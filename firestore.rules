rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS
    // Users can read/update their own profile, but never change their own role
    // or membership status via a client write. Admins can read/manage any profile.
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow update: if isAdmin() || (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'membershipStatus', 'memberNumber'])
      );
      allow list, create, delete: if isAdmin();
    }

    // GYM (single fixed branch)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CLASSES & TRAINERS
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trainers/{trainerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USER PRESENCE
    // Users update their own presence doc; admins can also write it (staff-
    // assisted check-in via the pass scanner). Any authenticated user can
    // list presence docs to compute the live occupancy count.
    match /userPresence/{userId} {
      allow read, list: if isAuth();
      allow write: if isUser(userId) || isAdmin();
    }

    // CHECK-IN LOG & HOURLY ROLLUP (for "busiest times")
    // Members can only log their own check-in; admins can log on a scanned
    // member's behalf. The hourly rollup is a simple incrementing counter,
    // trusted at the level appropriate for a single-gym app.
    match /checkIns/{checkInId} {
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read, list: if isAdmin();
    }
    match /gymStats/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // BOOKINGS (CLASSES & TRAINERS)
    match /classBookings/{bookingId} {
      allow create: if isAuth();
      allow read, update: if (isAuth() && request.auth.uid == resource.data.userId) || isAdmin();
      allow list, delete: if isAdmin();
    }

    match /trainerBookings/{bookingId} {
      allow create: if isAuth();
      allow read, update: if (isAuth() && request.auth.uid == resource.data.userId) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // GROUP CHAT (single fixed branch)
    match /chatMessages/{messageId} {
      allow read, list, create: if isAuth();
      allow delete: if isAdmin();
    }
  }
}

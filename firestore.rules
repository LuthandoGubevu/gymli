rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A user who has opted in to Gym Buddy is readable by any authenticated
    // member for matching purposes (profile, personal records, badges,
    // streak) - opting in is exactly the consent this widens on.
    function isBuddyVisible(userId) {
      return isAuth() && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.buddyOptIn == true;
    }

    // USERS
    // Users can read/update their own profile, but never change their own
    // role via a client write. Admins can read/manage any profile. A
    // Gym-Buddy-opted-in user's profile is also readable by any member, for
    // discovery (see isBuddyVisible above).
    match /users/{userId} {
      allow read, list: if isUser(userId) || isAdmin() || (isAuth() && resource.data.buddyOptIn == true);
      allow update: if isAdmin() || (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow create, delete: if isAdmin();
    }

    // GYM (single fixed branch)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CLASSES & TRAINERS
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trainers/{trainerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USER PRESENCE
    // Users update their own presence doc via geolocation auto/manual
    // check-in. Any authenticated user can list presence docs to compute
    // the live occupancy count.
    match /userPresence/{userId} {
      allow read, list: if isAuth();
      allow write: if isUser(userId);
    }

    // CHECK-IN LOG & HOURLY ROLLUP (for "busiest times")
    // Members can only log their own check-in. The hourly rollup is a
    // simple incrementing counter, trusted at the level appropriate for a
    // single-gym app.
    match /checkIns/{checkInId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isAdmin();
    }
    match /gymStats/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // CLASS SLOTS (per-occurrence capacity/waitlist tracking)
    // Booking/cancelling is a client-side transaction (no Cloud Functions in
    // this app), so any authenticated user can write slot counts - the same
    // trust level already accepted for gymStats above.
    match /classSlots/{slotId} {
      allow read: if true;
      allow create, update: if isAuth();
    }

    // BOOKINGS (CLASSES & TRAINERS)
    // classBookings: create is open; a member can read/update/list only
    // their own bookings (list requires the query to filter by their own
    // userId, which Firestore enforces). The one exception is promoting a
    // *different* member's waitlisted booking to confirmed when a spot
    // frees up - that write is made by whichever client processed the
    // cancellation, not by the promoted member themselves.
    match /classBookings/{bookingId} {
      allow create: if isAuth();
      allow read: if (isAuth() && request.auth.uid == resource.data.userId) || isAdmin();
      allow list: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (isAuth() && request.auth.uid == resource.data.userId) ||
        (isAuth() && resource.data.status == 'waitlisted' && request.resource.data.status == 'confirmed'
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /trainerBookings/{bookingId} {
      allow create: if isAuth();
      allow read, update: if (isAuth() && request.auth.uid == resource.data.userId) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // GROUP CHAT (single fixed branch)
    match /chatMessages/{messageId} {
      allow read, list, create: if isAuth();
      allow delete: if isAdmin();
    }

    // NOTIFICATIONS (e.g. waitlist promotion)
    // Created by whichever client triggers the event (may be a different
    // user, e.g. the member who cancels and frees a waitlist spot).
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isUser(userId) || isAdmin();
      allow create: if isAuth();
    }

    // GAMIFICATION (streaks, badges, personal records, leaderboard)
    // All self-write - there's no server component able to hold trusted
    // credentials in this app's actual deployment (Netlify, not Firebase
    // App Hosting), so this accepts the same client-trust tradeoff already
    // made for gymStats/classSlots: a member could inflate their own
    // stats via a direct write, but can't affect anyone else's.
    match /gymVisits/{visitId} {
      allow read: if isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
    match /gamification/{userId} {
      allow read: if isUser(userId) || isAdmin() || isBuddyVisible(userId);
      allow write: if isUser(userId);
    }
    match /personalRecords/{userId}/records/{recordId} {
      allow read: if isUser(userId) || isAdmin() || isBuddyVisible(userId);
      allow write: if isUser(userId) || isAdmin();
    }
    match /userBadges/{userId}/earned/{badgeId} {
      allow read: if isUser(userId) || isAdmin() || isBuddyVisible(userId);
      allow write: if isUser(userId);
    }
    match /leaderboard/{monthKey}/entries/{userId} {
      allow read, list: if isAuth();
      allow write: if isUser(userId);
    }

    // AI COACH & WORKOUT LOG
    // The AI flow itself runs server-side (route handler verifies the
    // caller's ID token before calling Gemini), but the client persists
    // the returned plan itself - self-write, same as everything above.
    match /workoutPlans/{userId}/plans/{planId} {
      allow read, write: if isUser(userId) || isAdmin();
    }
    match /workoutLogs/{userId}/logs/{logId} {
      allow read, write: if isUser(userId) || isAdmin();
    }
    match /bodyMetrics/{userId}/entries/{entryId} {
      allow read, write: if isUser(userId) || isAdmin();
    }

    // NOTICES (admin-posted gym announcements)
    match /notices/{noticeId} {
      allow read, list: if isAuth();
      allow write: if isAdmin();
    }

    // GYM BUDDY MATCHING
    // Swipe doc ID is deterministic ({fromUid}_{toUid}), so a duplicate
    // swipe is an overwrite of the same doc, not a race. A user can only
    // create a swipe recording their own action, and can read/list only
    // swipes where they're the sender or the recipient (recipient access
    // lets a client detect a mutual like from the other side).
    match /buddySwipes/{swipeId} {
      allow read, list: if isAuth() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create, update: if isAuth() && request.resource.data.fromUserId == request.auth.uid
        && swipeId == request.resource.data.fromUserId + '_' + request.resource.data.toUserId;
    }

    // matchId is the two uids sorted and joined with '_' (see getMatchId in
    // src/lib/buddy.ts), created client-side by whichever member's swipe
    // completes the mutual like - no server component to arbitrate this,
    // same trust level as gymStats/classSlots elsewhere in this app.
    match /buddyMatches/{matchId} {
      allow read, list: if isAuth() && request.auth.uid in resource.data.userIds;
      allow create: if isAuth() && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;
      allow update: if isAuth() && request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read, list: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/buddyMatches/$(matchId)).data.userIds;
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/buddyMatches/$(matchId)).data.userIds;
      }
    }
  }
}
